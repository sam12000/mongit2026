{
  "mcpServers": {
    "free-llm": {
      "command": "python3",
      "args": ["free_llm_mcp.py"],
      "env": {
        "FREE_LLM_PROVIDER": "${FREE_LLM_PROVIDER:-groq}",
        "GROQ_API_KEY": "${GROQ_API_KEY:-}",
        "GEMINI_API_KEY": "${GEMINI_API_KEY:-}",
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY:-}",
        "MISTRAL_API_KEY": "${MISTRAL_API_KEY:-}"
      }
    }
  }
}
